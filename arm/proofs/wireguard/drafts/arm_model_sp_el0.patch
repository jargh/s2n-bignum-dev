+(*** Instructions of the Linux kernel's atomics and RCU primitives, in a
+ *** sequential model: one CPU, and no other agent writing the memory.
+ ***
+ ***  - MRS Xt, SP_EL0 reads the system register SP_EL0 (in the arm64
+ ***    kernel, the current task), which no modelled instruction writes.
+ ***
+ ***  - The barriers DMB and the prefetch hint PRFM do nothing, and have
+ ***    their own constants as BTI does.
+ ***
+ ***  - LDXR and STLR are an ordinary load and store (decode.ml), and STXR
+ ***    and STLXR an ordinary store that writes 0 (success) to its status
+ ***    register. The exclusive monitor is not modelled: a store-exclusive
+ ***    is assumed to succeed, as it does after a matching LDXR with no
+ ***    other writer, except for the spurious failures that the
+ ***    architecture allows and the model excludes. The alignment faults of
+ ***    these instructions are not modelled either. The status register
+ ***    being the same as the data or base register is UNPREDICTABLE in the
+ ***    architecture, and gives an undefined state here.
+ ***
+ *** None of them is in the simulator's classes (simulator_iclasses.ml):
+ *** MRS SP_EL0 is not allowed at EL0, and store-exclusives may fail there.
+ ***)
+
+let arm_DMB = new_definition
+  `arm_DMB = \s s':armstate. s = s'`;;
+
+let arm_PRFM = new_definition
+  `arm_PRFM = \s s':armstate. s = s'`;;
+
+let arm_MRS_SP_EL0 = define
+ `arm_MRS_SP_EL0 (Rt:(armstate,int64)component) =
+    \s. (Rt := read SP_EL0 s) s`;;
+
 let arm_ORN = define
